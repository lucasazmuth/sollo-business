# URL pública do site (usada nas metatags OG/Twitter).
# Em produção na Vercel, pode ficar vazio: o domínio é detectado automaticamente.
NEXT_PUBLIC_SITE_URL=https://www.sollo.business

# Webhook que recebe o formulário de parcerias (Zapier, Make, n8n, Slack, Discord…).
# Sem esta variável, /api/contato responde 501 e o formulário avisa o usuário.
CONTACT_WEBHOOK_URL=
