{
  "expo": {
    "name": "Sollo Business",
    "slug": "sollo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sollo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.sollo.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.sollo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D81368"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Sollo Business usa suas fotos para montar seu portfólio e sua foto de perfil.",
          "cameraPermission": "A Sollo Business usa a câmera para você fotografar trabalhos direto do app."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "A Sollo Business usa sua localização para mostrar vagas perto de você e avisar quando surgir trabalho urgente na região.",
          "locationWhenInUsePermission": "A Sollo Business usa sua localização para mostrar vagas perto de você e avisar quando surgir trabalho urgente na região.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#D81368"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
